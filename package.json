  "description": "Convert GIFs into terminal-style ASCII animations with browser preview and terminal-ready exports.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "clean": "node -e \"require('fs').rmSync('./uploads', { recursive: true, force: true }); require('fs').mkdirSync('./uploads')\"
  },
